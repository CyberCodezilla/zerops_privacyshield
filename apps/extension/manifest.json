{
  "manifest_version": 3,
  "name": "PrivacyShield — Universal Zero-Trust AI Guard",
  "version": "2.5.0",
  "description": "Zero-Trust Real-Time PII & Secret Redaction Guard for ChatGPT, Claude, Gemini, Perplexity, DeepSeek, and custom AI chat interfaces.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PrivacyShield Guard Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://*.google.com/*",
    "*://*.perplexity.ai/*",
    "*://*.deepseek.com/*",
    "*://*.zerops.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.google.com/*",
        "*://*.perplexity.ai/*",
        "*://*.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["image-pipeline.js", "ocr-client.js", "rule-engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ocr-worker.js", "rule-engine.js", "models/*", "vendor/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
