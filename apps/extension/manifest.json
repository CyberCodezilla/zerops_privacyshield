{
  "manifest_version": 3,
  "name": "PrivacyShield — Universal Zero-Trust AI Guard",
  "version": "2.0.0",
  "description": "Zero-Trust Real-Time PII & Secret Redaction Guard for ChatGPT, Claude, Gemini, Perplexity, DeepSeek, and custom AI platforms.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PrivacyShield Options & Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://*.google.com/*",
    "*://*.perplexity.ai/*",
    "*://*.deepseek.com/*",
    "*://*.zerops.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.google.com/*",
        "*://*.perplexity.ai/*",
        "*://*.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["src/content/injector.js"],
      "run_at": "document_idle"
    }
  ]
}
